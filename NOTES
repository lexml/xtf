mvn org.apache.maven.plugins:maven-install-plugin:3.1.1:install-file \
  -Dfile=saxonb-8.9.jar \
  -DgroupId=net.sf.saxon \
  -DartifactId=saxon \
  -Dversion=8.9 \
  -Dpackaging=jar \
  -DgeneratePom=true

