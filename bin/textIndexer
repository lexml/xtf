#!/usr/bin/env perl

use File::Spec;
my ($vol, $dir, $file) = File::Spec->splitpath(File::Spec->rel2abs($0));
push @INC, File::Spec->catpath($vol, $dir, '');
require "classpath.pl";

exec "java -classpath \"$classpath\" -Xms4048m -Xmx8196m -XX:+UseParallelGC -Dxtf.home=\"$home\" -DentityExpansionLimit=128000 -enableassertions org.cdlib.xtf.textIndexer.TextIndexer $args";
